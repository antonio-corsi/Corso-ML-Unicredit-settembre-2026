		<properties node_id="11" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07t\x00\x00\x03\xbd\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07s\x00\x00\x03\xbc\x00\x00\x00\x00\x00\x00\x00\x00\x07t\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07s\x00\x00\x03\xbc', 'select_rows': True, 'show_attribute_labels': True, 'show_distributions': False, 'stored_selection': {'rows': [], 'columns': []}, 'stored_sort': [], '__version__': 1}</properties>
		<properties node_id="12" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07t\x00\x00\x03\x8d\x00\x00\x00\t\x00\x00\x00 \x00\x00\x07j\x00\x00\x03\x83\x00\x00\x00\x00\x02\x00\x00\x00\x07t\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07s\x00\x00\x03\x8c', 'scriptLibrary': [{'name': 'matrice di correlazione', 'script': '# Matrice di correlazione tra i predittori (+ risposta prezzo_vendita)\n# Da incollare nel widget "Python Script" di Orange Data Mining.\n# Input:  in_data  -&gt; la tabella caricata con il widget File (alloggi_vendita.csv)\n# Output: out_data -&gt; la matrice di correlazione come tabella Orange (collegabile a Data Table)\n\nimport matplotlib.pyplot as plt\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\n# --- Impostazioni -----------------------------------------------------------\nINCLUDI_BINARIE = True   # converte le variabili si/no in 0/1 (correlazione punto-biseriale)\nMETODO = "pearson"       # "spearman" per relazioni monotone non lineari\n# ---------------------------------------------------------------------------\n\ndf = table_to_frame(in_data, include_metas=False)\n\n# Selezioniamo le variabili numeriche del dominio (tipo "continuous")\nnumeriche = [v.name for v in in_data.domain.variables if v.is_continuous]\ncolonne = df[numeriche].copy()\n\n# Le variabili discrete si/no le ricodifichiamo in 0/1\nif INCLUDI_BINARIE:\n    for v in in_data.domain.variables:\n        if v.is_discrete and set(v.values) == {"si", "no"}:\n            colonne[v.name] = (df[v.name].astype(str) == "si").astype(int)\n\n# Spostiamo la risposta in fondo alla matrice\ntarget = in_data.domain.class_var.name if in_data.domain.class_var else "prezzo_vendita"\ncolonne = colonne[[c for c in colonne.columns if c != target] + [target]]\n\ncorr = colonne.corr(method=METODO)\n\n# --- Heatmap ----------------------------------------------------------------\nn = len(corr)\nfig, ax = plt.subplots(figsize=(0.7 * n + 3, 0.7 * n + 2))\nim = ax.imshow(corr.values, cmap="coolwarm", vmin=-1, vmax=1)\nax.set_xticks(range(n))\nax.set_xticklabels(corr.columns, rotation=45, ha="right")\nax.set_yticks(range(n))\nax.set_yticklabels(corr.index)\nfor i in range(n):\n    for j in range(n):\n        val = corr.values[i, j]\n        ax.text(j, i, f"{val:.2f}", ha="center", va="center", fontsize=8,\n                color="white" if abs(val) &gt; 0.5 else "black")\nfig.colorbar(im, ax=ax, fraction=0.046, pad=0.04, label=f"correlazione ({METODO})")\nax.set_title(f"Matrice di correlazione - risposta: {target}")\nfig.tight_layout()\nplt.show(block=False)\n\n# --- Correlazioni con la risposta, ordinate per valore assoluto (console) --\nprint(corr[target].drop(target).sort_values(key=abs, ascending=False).round(3))\n\n# --- Output verso Orange ----------------------------------------------------\nout_df = corr.round(3).reset_index().rename(columns={"index": "variabile"})\nout_data = table_from_frame(out_df)', 'filename': None}], 'scriptText': '# Matrice di correlazione tra i predittori (+ risposta prezzo_vendita)\n# Da incollare nel widget "Python Script" di Orange Data Mining.\n# Input:  in_data  -&gt; la tabella caricata con il widget File (alloggi_vendita.csv)\n# Output: out_data -&gt; la matrice di correlazione come tabella Orange (collegabile a Data Table)\n\nimport matplotlib.pyplot as plt\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\n# --- Impostazioni -----------------------------------------------------------\nINCLUDI_BINARIE = True   # converte le variabili si/no in 0/1 (correlazione punto-biseriale)\nMETODO = "pearson"       # "spearman" per relazioni monotone non lineari\n# ---------------------------------------------------------------------------\n\ndf = table_to_frame(in_data, include_metas=False)\n\n# Selezioniamo le variabili numeriche del dominio (tipo "continuous")\nnumeriche = [v.name for v in in_data.domain.variables if v.is_continuous]\ncolonne = df[numeriche].copy()\n\n# Le variabili discrete si/no le ricodifichiamo in 0/1\nif INCLUDI_BINARIE:\n    for v in in_data.domain.variables:\n        if v.is_discrete and set(v.values) == {"si", "no"}:\n            colonne[v.name] = (df[v.name].astype(str) == "si").astype(int)\n\n# Spostiamo la risposta in fondo alla matrice\ntarget = in_data.domain.class_var.name if in_data.domain.class_var else "prezzo_vendita"\ncolonne = colonne[[c for c in colonne.columns if c != target] + [target]]\n\ncorr = colonne.corr(method=METODO)\n\n# --- Heatmap ----------------------------------------------------------------\nn = len(corr)\nfig, ax = plt.subplots(figsize=(0.7 * n + 3, 0.7 * n + 2))\nim = ax.imshow(corr.values, cmap="coolwarm", vmin=-1, vmax=1)\nax.set_xticks(range(n))\nax.set_xticklabels(corr.columns, rotation=45, ha="right")\nax.set_yticks(range(n))\nax.set_yticklabels(corr.index)\nfor i in range(n):\n    for j in range(n):\n        val = corr.values[i, j]\n        ax.text(j, i, f"{val:.2f}", ha="center", va="center", fontsize=8,\n                color="white" if abs(val) &gt; 0.5 else "black")\nfig.colorbar(im, ax=ax, fraction=0.046, pad=0.04, label=f"correlazione ({METODO})")\nax.set_title(f"Matrice di correlazione - risposta: {target}")\nfig.tight_layout()\nplt.show(block=False)\n\n# --- Correlazioni con la risposta, ordinate per valore assoluto (console) --\nprint(corr[target].drop(target).sort_values(key=abs, ascending=False).round(3))\n\n# --- Output verso Orange ----------------------------------------------------\nout_df = corr.round(3).reset_index().rename(columns={"index": "variabile"})\nout_data = table_from_frame(out_df)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
