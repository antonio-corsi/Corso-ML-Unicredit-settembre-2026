		<properties node_id="30" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07\x80\x00\x00\x04\x10\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f', 'select_rows': True, 'show_attribute_labels': True, 'show_distributions': True, 'stored_selection': {'rows': [], 'columns': []}, 'stored_sort': [], '__version__': 1}</properties>
		<properties node_id="31" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07\x80\x00\x00\x04\x10\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': '# Missing-values matrix (missingno-style) for the Python Script widget.\n# One column per variable, one row per instance; red marks = missing.\n\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom matplotlib.colors import ListedColormap\n\nif in_data is None:\n    print("No input data: connect a data widget (e.g. File) to this Python Script.")\nelse:\n    # Attributes + class variables. Categorical columns work too: Orange\n    # stores categories as float codes, and a missing value is NaN there\n    # just like in numeric columns. (String metas are not included.)\n    vars_ = list(in_data.domain.variables)\n    mask = np.column_stack(\n        [np.isnan(in_data.get_column(v).astype(float)) for v in vars_])\n\n    n_missing = mask.sum()\n    pct = 100 * n_missing / mask.size\n    print(f"{n_missing} missing cells ({pct:.1f}%)")\n    for v, count in zip(vars_, mask.sum(axis=0)):\n        if count:\n            print(f"  {v.name}: {count}")\n\n    fig, ax = plt.subplots(figsize=(0.9 * len(vars_) + 2, 6))\n    ax.imshow(mask, aspect="auto", interpolation="nearest",\n              cmap=ListedColormap(["#f0f0f0", "#d62728"]))\n    ax.set_xticks(range(len(vars_)))\n    ax.set_xticklabels([v.name for v in vars_], rotation=30, ha="right")\n    ax.set_ylabel("row index")\n    ax.set_title(f"Missing values: {n_missing} cells ({pct:.1f}%)")\n    fig.tight_layout()\n    plt.show()\n\nout_data = in_data   # pass the data through unchanged', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
