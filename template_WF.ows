		<properties node_id="21" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07\x80\x00\x00\x04\x10\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': '# Side-by-side box plots of all numeric variables in the input table.\n# Paste into a Python Script widget and press "Run script".\n\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom Orange.data import TimeVariable\n\nSTANDARDIZE = False   # True -&gt; plot z-scores, so variables on different\n                      # scales (Income vs Balance) become comparable\n\nif in_data is None:\n    print("No input data: connect a data widget (e.g. File) to this Python Script.")\nelse:\n    # Numeric variables only. TimeVariable is technically continuous too\n    # (Unix seconds), but a box plot of timestamps is meaningless -&gt; skip it.\n    numeric = [v for v in in_data.domain.variables\n               if v.is_continuous and not isinstance(v, TimeVariable)]\n\n    if not numeric:\n        print("The input table has no numeric variables to plot.")\n    else:\n        series, names = [], []\n        for v in numeric:\n            col = in_data.get_column(v).astype(float)\n            col = col[~np.isnan(col)]        # boxplot cannot digest NaNs\n            if STANDARDIZE:\n                col = (col - col.mean()) / col.std()\n            series.append(col)\n            names.append(v.name)\n\n        fig, ax = plt.subplots(figsize=(1.2 * len(names) + 3, 5))\n        ax.boxplot(series)\n        ax.set_xticklabels(names, rotation=30, ha="right")\n        ax.set_ylabel("z-score" if STANDARDIZE else "value")\n        ax.set_title("Side-by-side box plots"\n                     + (" (standardized)" if STANDARDIZE else ""))\n        fig.tight_layout()\n        plt.show()\n\nout_data = in_data   # pass the data through unchanged, so the\n                     # workflow can continue after this widget', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
