		<properties node_id="8" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07\x80\x00\x00\x04\x10\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import numpy as np\nimport matplotlib.pyplot as plt\nfrom Orange.data import Table, Domain, ContinuousVariable, StringVariable\nfrom Orange.data.pandas_compat import table_to_frame\n\n# --- Impostazioni -----------------------------------------------------------\nINCLUDI_BINARIE = True   # converte le variabili Yes/No in 0/1 (correlazione punto-biseriale)\nMETODO = "pearson"       # "spearman" per relazioni monotone non lineari\nNUMERICHE_CREDIT = ["Income", "Limit", "Rating", "Cards", "Age", "Education", "Balance"]\n# ---------------------------------------------------------------------------\n\ndf = table_to_frame(in_data, include_metas=False)\n\n# Selezioniamo le variabili numeriche, escludendo la colonna contatore senza nome\nnumeriche = [v.name for v in in_data.domain.variables\n             if v.is_continuous and v.name in NUMERICHE_CREDIT]\ncolonne = df[numeriche].copy()\n\n# Le variabili discrete Yes/No (Student, Married) le ricodifichiamo in 0/1\nif INCLUDI_BINARIE:\n    for v in in_data.domain.variables:\n        if v.is_discrete and set(v.values) == {"Yes", "No"}:\n            colonne[v.name] = (df[v.name].astype(str) == "Yes").astype(int)\n\n# Spostiamo la risposta in fondo alla matrice\ntarget = in_data.domain.class_var.name if in_data.domain.class_var else "Balance"\ncolonne = colonne[[c for c in colonne.columns if c != target] + [target]]\n\n# Calcoliamo la matrice e mascheriamo il triangolo inferiore (sotto la diagonale)\ncorr = colonne.corr(method=METODO)\ncorr_m = corr.mask(np.tril(np.ones(corr.shape, dtype=bool), k=-1))\nprint(corr_m.round(3).fillna("").to_string())\n\n# Output per Data Table / Heat Map\ndominio = Domain([ContinuousVariable(c) for c in corr_m.columns],\n                 metas=[StringVariable("Variabile")])\nout_data = Table.from_numpy(dominio, corr_m.to_numpy(),\n                            metas=np.array(corr_m.index, dtype=object)[:, None])\n\n# Grafico: le celle mascherate restano bianche\nfig, ax = plt.subplots(figsize=(8, 7))\nim = ax.imshow(corr_m, cmap="coolwarm", vmin=-1, vmax=1)\nax.set_xticks(range(len(corr_m)), corr_m.columns, rotation=45, ha="right")\nax.set_yticks(range(len(corr_m)), corr_m.index)\nfor i in range(len(corr_m)):\n    for j in range(i, len(corr_m)):\n        ax.text(j, i, f"{corr_m.iloc[i, j]:.2f}", ha="center", va="center", fontsize=9)\nfig.colorbar(im, ax=ax, label=f"Correlazione ({METODO})")\nax.set_title("Matrice di correlazione - Credit")\nplt.tight_layout()\nplt.show()', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
