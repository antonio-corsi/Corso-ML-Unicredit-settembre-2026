		<properties node_id="12" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07t\x00\x00\x04\x08\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07s\x00\x00\x04\x07\x00\x00\x00\x00\x02\x00\x00\x00\x07t\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07s\x00\x00\x04\x07', 'scriptLibrary': [{'name': 'p-value coefficienti', 'script': '# p-value dei coefficienti della regressione lineare (OLS)\n# Rifacciamo con numpy lo stesso fit del widget Linear Regression e calcoliamo\n# errore standard, statistica t e p-value di ogni coefficiente.\n# Le variabili categoriche sono codificate con una dummy per livello meno il primo,\n# che fa da livello base (es. citta=Bari): stessa retta di regressione, ma i\n# coefficienti delle dummy vanno letti come differenza rispetto al livello base.\nimport numpy as np\nfrom scipy import stats\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable, StringVariable\nfrom Orange.preprocess import Continuize\n\nif in_data is None:\n    raise ValueError("Collegare i dati di training all\'ingresso Data")\n\n# 1) matrice del disegno: dummy con livello base + colonna di 1 per l\'intercetta\ndati = Continuize(multinomial_treatment=Continuize.FirstAsBase)(in_data)\nX = np.asarray(dati.X, dtype=float)\ny = np.asarray(dati.Y, dtype=float).ravel()\ncomplete = ~np.isnan(X).any(axis=1) &amp; ~np.isnan(y)\nX, y = X[complete], y[complete]\nX1 = np.column_stack([np.ones(len(X)), X])\ntermini = ["intercetta"] + [v.name for v in dati.domain.attributes]\n\n# 2) stima OLS e inferenza sui coefficienti\nbeta, *_ = np.linalg.lstsq(X1, y, rcond=None)\nn, p = X1.shape\ngdl = n - p                                   # gradi di liberta\' dei residui\nresidui = y - X1 @ beta\nrss = residui @ residui\nsigma2 = rss / gdl                            # varianza residua stimata\ncov_beta = sigma2 * np.linalg.pinv(X1.T @ X1) # covarianza dei coefficienti\nerr_std = np.sqrt(np.diag(cov_beta))\nt = beta / err_std\np_value = 2 * stats.t.sf(np.abs(t), gdl)      # test bilaterale H0: coefficiente = 0\n\n# 3) riepilogo del modello nella console\ntss = ((y - y.mean()) ** 2).sum()\nr2 = 1 - rss / tss\nr2_adj = 1 - (1 - r2) * (n - 1) / gdl\nf = ((tss - rss) / (p - 1)) / (rss / gdl)\nprint(f"n = {n}, coefficienti = {p} (intercetta inclusa), gdl residui = {gdl}")\nprint(f"R2 = {r2:.4f}   R2 corretto = {r2_adj:.4f}   RMSE in-sample = {np.sqrt(rss / n):,.0f}")\nprint(f"test F sul modello: F = {f:,.1f}, p-value = {stats.f.sf(f, p - 1, gdl):.3g}")\nprint(f"coefficienti con p-value &lt; 0.05: {(p_value &lt; 0.05).sum()} su {p}")\n\n# 4) tabella in uscita (Data): una riga per coefficiente, stelle come in R\ncodice = np.select([p_value &lt; 0.001, p_value &lt; 0.01, p_value &lt; 0.05, p_value &lt; 0.1],\n                   [4, 3, 2, 1], default=0)\ndominio = Domain([ContinuousVariable("coef"),\n                  ContinuousVariable("err_std"),\n                  ContinuousVariable("t", number_of_decimals=2),\n                  ContinuousVariable("p_value", number_of_decimals=4),\n                  DiscreteVariable("signif", values=["n.s.", ".", "*", "**", "***"])],\n                 metas=[StringVariable("termine")])\nout_data = Table.from_numpy(dominio,\n                            np.column_stack([beta, err_std, t, p_value, codice]),\n                            metas=np.array(termini, dtype=object).reshape(-1, 1))\n', 'filename': None}], 'scriptText': '# p-value dei coefficienti della regressione lineare (OLS)\n# Rifacciamo con numpy lo stesso fit del widget Linear Regression e calcoliamo\n# errore standard, statistica t e p-value di ogni coefficiente.\n# Le variabili categoriche sono codificate con una dummy per livello meno il primo,\n# che fa da livello base (es. citta=Bari): stessa retta di regressione, ma i\n# coefficienti delle dummy vanno letti come differenza rispetto al livello base.\nimport numpy as np\nfrom scipy import stats\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable, StringVariable\nfrom Orange.preprocess import Continuize\n\nif in_data is None:\n    raise ValueError("Collegare i dati di training all\'ingresso Data")\n\n# 1) matrice del disegno: dummy con livello base + colonna di 1 per l\'intercetta\ndati = Continuize(multinomial_treatment=Continuize.FirstAsBase)(in_data)\nX = np.asarray(dati.X, dtype=float)\ny = np.asarray(dati.Y, dtype=float).ravel()\ncomplete = ~np.isnan(X).any(axis=1) &amp; ~np.isnan(y)\nX, y = X[complete], y[complete]\nX1 = np.column_stack([np.ones(len(X)), X])\ntermini = ["intercetta"] + [v.name for v in dati.domain.attributes]\n\n# 2) stima OLS e inferenza sui coefficienti\nbeta, *_ = np.linalg.lstsq(X1, y, rcond=None)\nn, p = X1.shape\ngdl = n - p                                   # gradi di liberta\' dei residui\nresidui = y - X1 @ beta\nrss = residui @ residui\nsigma2 = rss / gdl                            # varianza residua stimata\ncov_beta = sigma2 * np.linalg.pinv(X1.T @ X1) # covarianza dei coefficienti\nerr_std = np.sqrt(np.diag(cov_beta))\nt = beta / err_std\np_value = 2 * stats.t.sf(np.abs(t), gdl)      # test bilaterale H0: coefficiente = 0\n\n# 3) riepilogo del modello nella console\ntss = ((y - y.mean()) ** 2).sum()\nr2 = 1 - rss / tss\nr2_adj = 1 - (1 - r2) * (n - 1) / gdl\nf = ((tss - rss) / (p - 1)) / (rss / gdl)\nprint(f"n = {n}, coefficienti = {p} (intercetta inclusa), gdl residui = {gdl}")\nprint(f"R2 = {r2:.4f}   R2 corretto = {r2_adj:.4f}   RMSE in-sample = {np.sqrt(rss / n):,.0f}")\nprint(f"test F sul modello: F = {f:,.1f}, p-value = {stats.f.sf(f, p - 1, gdl):.3g}")\nprint(f"coefficienti con p-value &lt; 0.05: {(p_value &lt; 0.05).sum()} su {p}")\n\n# 4) tabella in uscita (Data): una riga per coefficiente, stelle come in R\ncodice = np.select([p_value &lt; 0.001, p_value &lt; 0.01, p_value &lt; 0.05, p_value &lt; 0.1],\n                   [4, 3, 2, 1], default=0)\ndominio = Domain([ContinuousVariable("coef"),\n                  ContinuousVariable("err_std"),\n                  ContinuousVariable("t", number_of_decimals=2),\n                  ContinuousVariable("p_value", number_of_decimals=4),\n                  DiscreteVariable("signif", values=["n.s.", ".", "*", "**", "***"])],\n                 metas=[StringVariable("termine")])\nout_data = Table.from_numpy(dominio,\n                            np.column_stack([beta, err_std, t, p_value, codice]),\n                            metas=np.array(termini, dtype=object).reshape(-1, 1))\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="13" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07t\x00\x00\x04\x08\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07s\x00\x00\x04\x07\x00\x00\x00\x00\x02\x00\x00\x00\x07t\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07s\x00\x00\x04\x07', 'select_rows': True, 'selected_cols': None, 'selected_rows': None, 'show_attribute_labels': True, 'show_distributions': True, '__version__': 2}</properties>
		<properties node_id="14" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07t\x00\x00\x03\xbd\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07s\x00\x00\x03\xbc\x00\x00\x00\x00\x00\x00\x00\x00\x07t\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07s\x00\x00\x03\xbc', 'select_rows': True, 'show_attribute_labels': True, 'show_distributions': False, 'stored_selection': {'rows': [], 'columns': []}, 'stored_sort': [], '__version__': 1}</properties>
		<properties node_id="15" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07t\x00\x00\x03\x8d\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07s\x00\x00\x04\x07\x00\x00\x00\x00\x02\x00\x00\x00\x07t\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07s\x00\x00\x03\x8c', 'scriptLibrary': [{'name': 'matrice di correlazione', 'script': '# Matrice di correlazione tra i predittori (+ risposta prezzo_vendita)\n# Da incollare nel widget "Python Script" di Orange Data Mining.\n# Input:  in_data  -&gt; la tabella caricata con il widget File (alloggi_vendita.csv)\n# Output: out_data -&gt; la matrice di correlazione come tabella Orange (collegabile a Data Table)\n\nimport matplotlib.pyplot as plt\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\n# --- Impostazioni -----------------------------------------------------------\nINCLUDI_BINARIE = True   # converte le variabili si/no in 0/1 (correlazione punto-biseriale)\nMETODO = "pearson"       # "spearman" per relazioni monotone non lineari\n# ---------------------------------------------------------------------------\n\ndf = table_to_frame(in_data, include_metas=False)\n\n# Selezioniamo le variabili numeriche del dominio (tipo "continuous")\nnumeriche = [v.name for v in in_data.domain.variables if v.is_continuous]\ncolonne = df[numeriche].copy()\n\n# Le variabili discrete si/no le ricodifichiamo in 0/1\nif INCLUDI_BINARIE:\n    for v in in_data.domain.variables:\n        if v.is_discrete and set(v.values) == {"si", "no"}:\n            colonne[v.name] = (df[v.name].astype(str) == "si").astype(int)\n\n# Spostiamo la risposta in fondo alla matrice\ntarget = in_data.domain.class_var.name if in_data.domain.class_var else "prezzo_vendita"\ncolonne = colonne[[c for c in colonne.columns if c != target] + [target]]\n\ncorr = colonne.corr(method=METODO)\n\n# --- Heatmap ----------------------------------------------------------------\nn = len(corr)\nfig, ax = plt.subplots(figsize=(0.7 * n + 3, 0.7 * n + 2))\nim = ax.imshow(corr.values, cmap="coolwarm", vmin=-1, vmax=1)\nax.set_xticks(range(n))\nax.set_xticklabels(corr.columns, rotation=45, ha="right")\nax.set_yticks(range(n))\nax.set_yticklabels(corr.index)\nfor i in range(n):\n    for j in range(n):\n        val = corr.values[i, j]\n        ax.text(j, i, f"{val:.2f}", ha="center", va="center", fontsize=8,\n                color="white" if abs(val) &gt; 0.5 else "black")\nfig.colorbar(im, ax=ax, fraction=0.046, pad=0.04, label=f"correlazione ({METODO})")\nax.set_title(f"Matrice di correlazione - risposta: {target}")\nfig.tight_layout()\nplt.show(block=False)\n\n# --- Correlazioni con la risposta, ordinate per valore assoluto (console) --\nprint(corr[target].drop(target).sort_values(key=abs, ascending=False).round(3))\n\n# --- Output verso Orange ----------------------------------------------------\nout_df = corr.round(3).reset_index().rename(columns={"index": "variabile"})\nout_data = table_from_frame(out_df)', 'filename': None}], 'scriptText': '# Matrice di correlazione tra i predittori (+ risposta prezzo_vendita)\n# Da incollare nel widget "Python Script" di Orange Data Mining.\n# Input:  in_data  -&gt; la tabella caricata con il widget File (alloggi_vendita.csv)\n# Output: out_data -&gt; la matrice di correlazione come tabella Orange (collegabile a Data Table)\n\nimport matplotlib.pyplot as plt\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\n# --- Impostazioni -----------------------------------------------------------\nINCLUDI_BINARIE = True   # converte le variabili si/no in 0/1 (correlazione punto-biseriale)\nMETODO = "pearson"       # "spearman" per relazioni monotone non lineari\n# ---------------------------------------------------------------------------\n\ndf = table_to_frame(in_data, include_metas=False)\n\n# Selezioniamo le variabili numeriche del dominio (tipo "continuous")\nnumeriche = [v.name for v in in_data.domain.variables if v.is_continuous]\ncolonne = df[numeriche].copy()\n\n# Le variabili discrete si/no le ricodifichiamo in 0/1\nif INCLUDI_BINARIE:\n    for v in in_data.domain.variables:\n        if v.is_discrete and set(v.values) == {"si", "no"}:\n            colonne[v.name] = (df[v.name].astype(str) == "si").astype(int)\n\n# Spostiamo la risposta in fondo alla matrice\ntarget = in_data.domain.class_var.name if in_data.domain.class_var else "prezzo_vendita"\ncolonne = colonne[[c for c in colonne.columns if c != target] + [target]]\n\ncorr = colonne.corr(method=METODO)\n\n# --- Heatmap ----------------------------------------------------------------\nn = len(corr)\nfig, ax = plt.subplots(figsize=(0.7 * n + 3, 0.7 * n + 2))\nim = ax.imshow(corr.values, cmap="coolwarm", vmin=-1, vmax=1)\nax.set_xticks(range(n))\nax.set_xticklabels(corr.columns, rotation=45, ha="right")\nax.set_yticks(range(n))\nax.set_yticklabels(corr.index)\nfor i in range(n):\n    for j in range(n):\n        val = corr.values[i, j]\n        ax.text(j, i, f"{val:.2f}", ha="center", va="center", fontsize=8,\n                color="white" if abs(val) &gt; 0.5 else "black")\nfig.colorbar(im, ax=ax, fraction=0.046, pad=0.04, label=f"correlazione ({METODO})")\nax.set_title(f"Matrice di correlazione - risposta: {target}")\nfig.tight_layout()\nplt.show(block=False)\n\n# --- Correlazioni con la risposta, ordinate per valore assoluto (console) --\nprint(corr[target].drop(target).sort_values(key=abs, ascending=False).round(3))\n\n# --- Output verso Orange ----------------------------------------------------\nout_df = corr.round(3).reset_index().rename(columns={"index": "variabile"})\nout_data = table_from_frame(out_df)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
